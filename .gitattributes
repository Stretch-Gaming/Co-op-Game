# Normalise line endings for text files (mixed Mac + Windows team)
* text=auto
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf
*.sh  text eol=lf
*.command text eol=lf

# Unreal binary assets live in LFS
*.uasset filter=lfs diff=lfs merge=lfs -text
*.umap   filter=lfs diff=lfs merge=lfs -text

# Shared folders are lockable: read-only until you `git lfs lock` a file.
# Lane folders are not, so each owner can save their own work freely.
Content/Core/**   lockable
Content/Maps/**   lockable
Content/Shared/** lockable

