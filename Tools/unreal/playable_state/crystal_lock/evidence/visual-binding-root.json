    "RefreshLock": "(fn RefreshLock ()\n  (if (Networking|HasAuthority)\n    (bind _asbp_coop_game_state (Utilities|Casting|CastToBP_CoopGameState (Game|GetGameState)))\n    (|SetwithNotifyEnabled (< (Variables|Default|GetLockSlot) (select (Variables|Default|GetBrazier) (select (Utilities|Name|Equal(Name) (Utilities|Struct|BreakSRoundState (Class|BPCoopGameState|GetRoundState _asbp_coop_game_state)) \"4\") 2 1) (select (Utilities|Name|Equal(Name) (Utilities|Struct|BreakSRoundState (Class|BPCoopGameState|GetRoundState _asbp_coop_game_state)) \"2\") 1 2))))\n    (Variables|Default|SetSourceCount 0)\n    (for _array_element (Variables|Default|GetLightSources)\n      (Utilities|IsValid _array_element\n        (:\"Is Valid\"\n          (if (Variables|Default|GetBrazier)\n            (bind _asbp_flare (Utilities|Casting|CastToBP_Flare _array_element))\n            (bind _active (Components|Activation|IsActive _asbp_flare))\n            (if _active\n              (Variables|Default|SetSourceCount (+ (Variables|Default|GetSourceCount) 1)))\n            (else\n              (bind _asac_health (Utilities|Casting|CastToAC_Health (Actor|GetComponentByClass _array_element \"/Game/Hazards/AC_Health.AC_Health_C\")))\n              (bind _dead (Class|ACHealth|IsDead _asac_health))\n              (if (not _dead)\n                (Variables|Default|SetSourceCount (+ (Variables|Default|GetSourceCount) 1))))))))\n    (|SetwithNotifyLit (and (Variables|Default|GetEnabled) (> (Variables|Default|GetSourceCount) 0)))\n    (CallFunction|ApplyLock)))\n",
