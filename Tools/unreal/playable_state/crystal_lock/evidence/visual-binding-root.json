    "ApplyLock": "(fn ApplyLock ()\n  (CallFunction|RefreshCrystalLockPresentation)\n  (Rendering|SetActorHiddenInGame (not (Variables|Default|GetEnabled)))\n  (Collision|SetActorEnableCollision (Variables|Default|GetEnabled))\n  (Rendering|SetRenderCustomDepth (Variables|StaticMeshActor|GetStaticMeshComponent) (Variables|Default|GetLit)))\n",
    "BeginLight": "(fn BeginLight (Source)\n  (if (Networking|HasAuthority)\n    (Utilities|IsValid Source\n      (:\"Is Valid\"\n        (if (Variables|Default|GetBrazier)\n          (bind _asbp_flare (Utilities|Casting|CastToBP_Flare Source))\n          (bind _active (Components|Activation|IsActive _asbp_flare))\n          (if _active\n            (Utilities|Array|AddUnique (Variables|Default|GetLightSources) Source))\n          (else\n            (bind _asbp_coop_character (Utilities|Casting|CastToBP_CoopCharacter Source))\n            (bind _asac_health (Utilities|Casting|CastToAC_Health (Actor|GetComponentByClass _asbp_coop_character \"/Game/Hazards/AC_Health.AC_Health_C\")))\n            (bind _dead (Class|ACHealth|IsDead _asac_health))\n            (if (not _dead)\n              (Utilities|Array|AddUnique (Variables|Default|GetLightSources) Source))))))))\n",
