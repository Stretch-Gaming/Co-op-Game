(fn UpdateProgress () (if (Networking|HasAuthority)
 (CallFunction|RefreshState)
 (bind held (CallFunction|GateHeld))
 (if (and (Variables|Default|GetRoundPlaying) (Variables|Default|GetSingletonValid))
  (for pawn (Actor|GetAllActorsOfClass :ActorClass "/Game/Core/BP_CoopCharacter.BP_CoopCharacter_C")
   (bind allowed (CallFunction|ValidatePawn :Pawn pawn))
   (if allowed
    (bind (x y z) (Math|Vector|BreakVector :InVec (Math|Transform|InverseTransformLocation :T (Transformation|GetActorTransform) :Location (Transformation|GetActorLocation :self pawn))))
    (if (and (and (<= y (Variables|Default|GetHalfWidth)) (>= y (- 0.0 (Variables|Default|GetHalfWidth)))) (and (<= z (Variables|Default|GetHalfHeight)) (>= z (- 0.0 (Variables|Default|GetHalfHeight)))))
     (if (and (<= x (Variables|Default|GetEntryX)) (>= x (- (Variables|Default|GetEntryX) 300.0)))
      (Utilities|Array|AddUnique :TargetArray (Variables|Default|GetEnteredPawns) :NewItem pawn))
     (if (and (and (>= x (Variables|Default|GetCrossX)) (<= x (+ (Variables|Default|GetCrossX) 600.0)))
              (and (Utilities|Array|ContainsItem :TargetArray (Variables|Default|GetEnteredPawns) :ItemToFind pawn) held))
      (Utilities|Array|AddUnique :TargetArray (Variables|Default|GetCrossedPawns) :NewItem pawn))))))))