 (bind current (and (and (== index 3) (Utilities|Enum|Equal(Enum) phase (Utilities|Enum|LiteralenumE_RoundPhase :Enum "NewEnumerator1"))) (== attempt (Variables|Default|GetCurrentAttempt))))
