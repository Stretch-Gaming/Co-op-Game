(event EventTick (DeltaSeconds)
  (bind t (+ (Utilities|Time|GetGameTimeinSeconds) (Variables|Default|GetPhase)))
  (bind speed (Variables|Default|GetOrbitSpeed))
  (bind a (* t speed))
  (bind r (Variables|Default|GetOrbitRadius))
  (Transformation|SetRelativeLocationAndRotation (Variables|Default|GetBat)
    (Math|Vector|MakeVector (* r (Math|Trig|Cos(Degrees) a)) (* r (Math|Trig|Sin(Degrees) a)) (* (Variables|Default|GetBobHeight) (Math|Trig|Sin(Degrees) (* a 2.3))))
    (Math|Rotator|MakeRotator 0.0 0.0 (+ a (* 90.0 (Math|Float|Sign(Float) speed)))))
  (bind flap (+ (Variables|Default|GetWingLift) (* (Variables|Default|GetFlapAngle) (Math|Trig|Sin(Degrees) (* t (Variables|Default|GetFlapSpeed))))))
  (Transformation|SetRelativeRotation (Variables|Default|GetHingeL) (Math|Rotator|MakeRotator flap 0.0 0.0))
  (Transformation|SetRelativeRotation (Variables|Default|GetHingeR) (Math|Rotator|MakeRotator (- flap) 0.0 0.0)))
